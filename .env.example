# Quinzex Intelligence - EmailJS Configuration
# Sign up and configure your service, template, and public key at https://www.emailjs.com

# Your EmailJS Service ID (e.g. service_xxxxxxx)
VITE_EMAILJS_SERVICE_ID=

# Your EmailJS Template ID (e.g. template_xxxxxxx)
VITE_EMAILJS_TEMPLATE_ID=

# Your EmailJS Public Key / User ID (e.g. your_public_key)
VITE_EMAILJS_PUBLIC_KEY=
